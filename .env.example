# Public Environment Variables (Browser-accessible)
# These variables are exposed to the browser via Astro's import.meta.env

# Site URL (used for SEO, meta tags, canonical URLs)
PUBLIC_SITE_URL=http://localhost:4321

# Environment name (development, preview, production)
PUBLIC_ENVIRONMENT=development

# CDN URL for media assets (Cloudflare R2)
PUBLIC_CDN_URL=https://cdn.labxr.art

# Cloudflare R2 bucket name
PUBLIC_R2_BUCKET_NAME=labxr-assets

# Cloudflare Pages project name
PUBLIC_CLOUDFLARE_PAGES_PROJECT_NAME=labxr-web

# Cloudflare Turnstile site key (for contact form)
PUBLIC_TURNSTILE_SITE_KEY=

# ============================================
# Private Environment Variables (Server-only)
# These variables are NOT exposed to the browser
# Store in .env for local development
# Store in Cloudflare Pages dashboard for production
# ============================================

# Cloudflare account ID (for Wrangler CLI)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token (for Wrangler CLI)
CLOUDFLARE_API_TOKEN=

# R2 access credentials (for direct S3 API access)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare Turnstile secret key (for server-side validation)
# Store in Worker secrets, not in .env
# TURNSTILE_SECRET_KEY=

# Discord webhook URL (for form submissions)
# Store in Worker secrets, not in .env
# DISCORD_WEBHOOK_URL=

# Contact form webhook URL (Discord/Slack)
# Store in Worker secrets, not in .env
# CONTACT_WEBHOOK_URL=
