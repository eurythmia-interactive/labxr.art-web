---
import Container from '@/components/shared/Container.astro';

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    href: 'https://github.com/eurythmia-interactive',
    label: 'GitHub',
  },
  {
    href: 'https://linkedin.com',
    label: 'LinkedIn',
  },
  {
    href: 'mailto:hello@labxr.art',
    label: 'Email',
  },
];
---

<footer class="border-t border-border bg-secondary">
  <Container className="py-12 md:py-16">
    <div class="grid gap-8 md:grid-cols-3">
      {/* Brand */}
      <div>
        <a href="/" class="text-xl font-bold tracking-tight text-foreground">
          LabXR<span class="text-primary">.art</span>
        </a>
        <p class="mt-3 text-sm text-foreground/60">
          Creative technology lab bridging code and cinema in CDMX.
        </p>
        <div class="mt-4 flex items-center gap-2 text-sm text-foreground/60">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Mexico City, Mexico</span>
        </div>
      </div>

      {/* Navigation */}
      <nav aria-label="Footer navigation">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-foreground/80">
          Navigation
        </h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href="/#work" class="text-sm text-foreground/60 transition-colors hover:text-primary">
              Work
            </a>
          </li>
          <li>
            <a href="/#services" class="text-sm text-foreground/60 transition-colors hover:text-primary">
              Services
            </a>
          </li>
          <li>
            <a href="/#manifesto" class="text-sm text-foreground/60 transition-colors hover:text-primary">
              Manifesto
            </a>
          </li>
          <li>
            <a href="/#contact" class="text-sm text-foreground/60 transition-colors hover:text-primary">
              Contact
            </a>
          </li>
        </ul>
      </nav>

      {/* Social */}
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-foreground/80">
          Connect
        </h3>
        <ul class="mt-4 space-y-3">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="flex items-center gap-2 text-sm text-foreground/60 transition-colors hover:text-primary"
              >
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Copyright */}
    <div class="mt-12 border-t border-border pt-8 text-center">
      <p class="text-sm text-foreground/60">
        &copy; {currentYear} LabXR.art. All rights reserved.
      </p>
    </div>
  </Container>
</footer>
