---
interface Props {
  id?: string;
  className?: string;
  padding?: 'sm' | 'md' | 'lg' | 'xl';
}

const { id, className = '', padding = 'lg' } = Astro.props;

const paddingClasses = {
  sm: 'py-8 md:py-12',
  md: 'py-12 md:py-16',
  lg: 'py-16 md:py-24',
  xl: 'py-24 md:py-32',
};

const paddingClass = paddingClasses[padding];
---

<section id={id} class={`${paddingClass} ${className}`}>
  <slot />
</section>
