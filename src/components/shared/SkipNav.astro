---
interface Props {
  href?: string;
}

const { href = '#main-content' } = Astro.props;
---

<a
  {href}
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-accent-primary focus:text-bg-primary focus:px-4 focus:py-2 focus:rounded-md focus:text-sm focus:font-medium focus:shadow-lg"
>
  Skip to main content
</a>
