---
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from '@/components/ui/card';
import { LucideIcon } from '@/components/islands/lucide-icon';

interface Props {
  title: string;
  description: string;
  iconName: string;
  slug: string;
  previewVideoUrl?: string;
  previewPosterUrl?: string;
}

const { title, description, iconName, slug, previewVideoUrl, previewPosterUrl } = Astro.props;
---

<button
  type="button"
  class="service-card group block w-full text-left transition-all duration-300 hover:scale-[1.02]"
  data-service-id={slug}
  data-preview-video={previewVideoUrl}
  data-preview-poster={previewPosterUrl}
  data-title={title}
>
  <Card className="h-full border-border bg-secondary transition-colors duration-300 group-hover:border-primary">
    <CardHeader>
      <div class="mb-2 flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary/20">
        <LucideIcon client:load name={iconName} className="h-6 w-6" />
      </div>
      <CardTitle className="text-xl">{title}</CardTitle>
    </CardHeader>
    <CardContent>
      <CardDescription className="text-sm text-foreground/60">
        {description}
      </CardDescription>
    </CardContent>
    {previewVideoUrl && (
      <div class="service-card-video absolute inset-0 overflow-hidden rounded-lg opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        <video
          class="h-full w-full object-cover"
          preload="auto"
          muted
          loop
          playsinline
          webkit-playsinline
          x5-playsinline
          x5-video-player-type="h5"
          poster={previewPosterUrl}
        />
      </div>
    )}
  </Card>
</button>

<script>
  import { $isMobile } from '@/lib/stores/device';
  import { trackEvent, AnalyticsEvents } from '@/lib/analytics';
  import { openService } from '@/lib/stores/service';

  const cards = document.querySelectorAll('.service-card[data-preview-video]');

  if (!$isMobile.get()) {
    cards.forEach((card) => {
      const videoUrl = card.getAttribute('data-preview-video');
      const videoEl = card.querySelector('video') as HTMLVideoElement | null;
      const title = card.getAttribute('data-title') || '';

      if (!videoEl || !videoUrl) return;

      card.addEventListener('mouseenter', () => {
        if (!videoEl.src) {
          videoEl.src = videoUrl;
          videoEl.load();
        }

        const playVideo = () => {
          const playPromise = videoEl.play();
          if (playPromise !== undefined) {
            playPromise.catch((error) => {
              console.warn('Video playback failed:', error);
            });
          }
        };

        if (videoEl.readyState >= 3) {
          playVideo();
        } else {
          videoEl.addEventListener('canplay', playVideo, { once: true });
        }

        trackEvent({ name: AnalyticsEvents.SERVICE_HOVER, properties: { service: title } });
      });

      card.addEventListener('mouseleave', () => {
        videoEl.pause();
        videoEl.removeAttribute('src');
        videoEl.load();
      });
    });
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const button = target.closest('[data-service-id]') as HTMLElement | null;
    if (button) {
      const id = button.dataset.serviceId;
      if (id) {
        openService(id);
      }
    }
  });
</script>
