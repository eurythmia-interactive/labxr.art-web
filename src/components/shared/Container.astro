---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  className?: string;
}

const { size = 'md', className = '' } = Astro.props;

const sizeClasses = {
  sm: 'max-w-screen-sm',
  md: 'max-w-screen-md',
  lg: 'max-w-screen-lg',
  xl: 'max-w-screen-xl',
  full: 'max-w-full',
};

const sizeClass = sizeClasses[size];
---

<div class={`mx-auto px-4 md:px-6 lg:px-8 ${sizeClass} ${className}`}>
  <slot />
</div>
