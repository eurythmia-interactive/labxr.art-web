---
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  className?: string;
}

const { level = 1, className = '' } = Astro.props;

const sizeClasses = {
  1: 'text-5xl md:text-6xl lg:text-7xl',
  2: 'text-4xl md:text-5xl lg:text-6xl',
  3: 'text-3xl md:text-4xl lg:text-5xl',
  4: 'text-2xl md:text-3xl lg:text-4xl',
  5: 'text-xl md:text-2xl lg:text-3xl',
  6: 'text-lg md:text-xl lg:text-2xl',
};

const sizeClass = sizeClasses[level];
const baseClasses = `font-bold tracking-tight text-text-primary ${sizeClass} ${className}`;
---

{
  level === 1 && (
    <h1 class={baseClasses}>
      <slot />
    </h1>
  )
}
{
  level === 2 && (
    <h2 class={baseClasses}>
      <slot />
    </h2>
  )
}
{
  level === 3 && (
    <h3 class={baseClasses}>
      <slot />
    </h3>
  )
}
{
  level === 4 && (
    <h4 class={baseClasses}>
      <slot />
    </h4>
  )
}
{
  level === 5 && (
    <h5 class={baseClasses}>
      <slot />
    </h5>
  )
}
{
  level === 6 && (
    <h6 class={baseClasses}>
      <slot />
    </h6>
  )
}
