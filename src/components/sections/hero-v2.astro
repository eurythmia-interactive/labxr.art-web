---
import Container from '@/components/shared/Container.astro';
import { ShowcaseWebGL } from '@/components/islands/showcase-webgl';
import { HeroHud } from '@/components/islands/hero-hud';
import VideoPlayer from '@/components/shared/video-player.astro';
import { cn } from '@/lib/utils';
import type { VideoConfig } from '@/lib/video/types';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const heroVideo: VideoConfig = {
  src: {
    mp4: '/videos/test-video.mp4',
    webm: '/videos/test-video.webm',
  },
  poster: '/videos/test-video-poster.webp',
  thumbnail: '/videos/test-video-thumb.webp',
  alt: 'Hero background video',
  autoplay: true,
  muted: true,
  loop: true,
};
---

<section class={cn('relative flex min-h-screen flex-col items-center justify-center overflow-hidden', className)}>
  <!-- Video Fallback (Mobile / No WebGL) -->
  <div class="absolute inset-0 md:hidden">
    <VideoPlayer
      config={heroVideo}
      aspectRatio="16:9"
      className="h-full w-full [&>div]:h-full [&>div]:w-full [&>div]:rounded-none"
    />
  </div>
  
  <!-- WebGL Canvas (Desktop) -->
  <div class="absolute inset-0 hidden md:block" data-cursor="drag">
    <ShowcaseWebGL client:visible />
  </div>

  <!-- Desktop Video Fallback (when WebGL fails) -->
  <div class="absolute inset-0 hidden md:block" id="hero-video-fallback" style="display: none;">
    <VideoPlayer
      config={heroVideo}
      aspectRatio="16:9"
      className="h-full w-full [&>div]:h-full [&>div]:w-full [&>div]:rounded-none"
    />
  </div>

  <!-- Static Image Fallback -->
  <div class="absolute inset-0" id="hero-static-fallback" style="display: none;">
    <img src="https://placehold.co/1920x1080/0a0a0a/00d4ff?text=LABXR.ART" alt="LabXR.art" class="h-full w-full object-cover" />
  </div>

  <!-- Gradient Overlay (reduced opacity) -->
  <div class="absolute inset-0 bg-gradient-to-b from-bg-primary/10 via-bg-primary/20 to-bg-primary/60" />

  <!-- Content -->
  <Container className="relative z-10 flex flex-col items-center text-center">
    <!-- Main Statement -->
    <div class="space-y-6">
      <h1 class="font-sans text-4xl font-bold tracking-tight text-foreground md:text-6xl lg:text-7xl">
        LABXR.ART
      </h1>
      <p class="max-w-3xl font-sans text-lg font-medium leading-relaxed text-text-secondary md:text-xl">
        Digital creation studio and technology experimentation laboratory.
      </p>
      <p class="font-mono text-xs tracking-wider text-text-tertiary md:text-sm">
        XR · IMMERSIVE SPACES · SENSORS · INTERACTION
      </p>
      <p class="font-mono text-xs tracking-wider text-accent-primary md:text-sm">
        CDMX · MEXICO // GLOBAL REACH
      </p>
    </div>

    <!-- Interactive Canvas Label -->
    <HeroHud client:visible />
  </Container>

  <!-- Authority Ticker -->
  <div class="absolute bottom-0 left-0 right-0 border-t border-white/8 bg-bg-primary/80 py-4 backdrop-blur-sm">
    <div class="overflow-hidden">
      <div class="animate-ticker flex whitespace-nowrap">
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">
          20 YEARS OF DIGITAL CREATION
        </span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">
          COMMERCIAL × EXPERIMENTAL
        </span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">XR</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">INTERACTION</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">CODE</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
        <!-- Duplicate for seamless loop -->
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">
          20 YEARS OF DIGITAL CREATION
        </span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">
          COMMERCIAL × EXPERIMENTAL
        </span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">XR</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">INTERACTION</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-secondary">CODE</span>
        <span class="mx-8 font-mono text-xs tracking-wider text-text-tertiary">·</span>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-24 left-1/2 -translate-x-1/2 md:bottom-28">
    <div class="flex flex-col items-center gap-2">
      <span class="font-mono text-xs tracking-wider text-text-tertiary">EXPLORE</span>
      <div class="h-12 w-px animate-pulse bg-gradient-to-b from-accent-primary to-transparent" />
    </div>
  </div>
</section>

<style>
  @keyframes ticker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-ticker {
    animation: ticker 30s linear infinite;
  }
</style>

<script>
  // Check if WebGL canvas rendered successfully
  function checkWebGLFallback() {
    // Only run on desktop
    if (window.innerWidth < 768) return;

    const webglContainer = document.querySelector('.hidden.md:block [data-cursor="drag"]') as HTMLElement | null;
    const videoFallback = document.getElementById('hero-video-fallback') as HTMLElement | null;
    const staticFallback = document.getElementById('hero-static-fallback') as HTMLElement | null;

    if (!webglContainer || !videoFallback || !staticFallback) return;

    // Check if WebGL canvas exists and has content
    const canvas = webglContainer.querySelector('canvas') as HTMLCanvasElement | null;
    
    if (!canvas) {
      // No canvas found, show video fallback
      videoFallback.style.display = 'block';
      webglContainer.style.display = 'none';
      return;
    }

    // Check if WebGL context exists
    const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
    if (!gl) {
      // WebGL context failed, show video fallback
      videoFallback.style.display = 'block';
      webglContainer.style.display = 'none';
      return;
    }

    // WebGL seems to be working, canvas should be visible
    // If after 2 seconds the canvas is still black, show static fallback
    setTimeout(() => {
      try {
        const webglCtx = gl as WebGLRenderingContext;
        const pixels = new Uint8Array(4);
        webglCtx.readPixels(0, 0, 1, 1, webglCtx.RGBA, webglCtx.UNSIGNED_BYTE, pixels);
        // If all pixels are black (0,0,0,255), show static fallback
        if (pixels[0] === 0 && pixels[1] === 0 && pixels[2] === 0) {
          staticFallback.style.display = 'block';
          webglContainer.style.display = 'none';
        }
      } catch (e) {
        // If we can't read pixels, assume WebGL is working
        console.warn('Could not verify WebGL rendering:', e);
      }
    }, 2000);
  }

  // Run check after page loads
  if (document.readyState === 'complete') {
    checkWebGLFallback();
  } else {
    window.addEventListener('load', checkWebGLFallback);
  }
</script>
