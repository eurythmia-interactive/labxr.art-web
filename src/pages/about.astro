---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/shared/Container.astro';
import AboutV2 from '@/components/sections/about-v2.astro';
---

<BaseLayout title="About — LabXR.art" description="20 years of creating with technology at LabXR.art">
  <main id="main-content" class="pt-20">
    <!-- Page Hero -->
    <section class="border-t border-white/8 bg-bg-primary py-24 md:py-32">
      <Container>
        <div class="max-w-4xl">
          <p class="mb-4 font-mono text-xs tracking-wider text-accent-primary">03 / ABOUT</p>
          <h1 class="mb-6 font-sans text-4xl font-bold tracking-tight text-foreground md:text-5xl lg:text-6xl">
            20 years of creating with technology.
          </h1>
          <p class="max-w-2xl font-sans text-lg leading-relaxed text-text-secondary">
            LABXR.art is a digital creation studio and technology experimentation laboratory based in CDMX. 
            We bridge the gap between intangible code and perceptible physical space — transforming data, 
            light, hardware, and narrative into memorable human experiences.
          </p>
        </div>
      </Container>
    </section>

    <!-- About Content -->
    <AboutV2 />

    <!-- Closing CTA -->
    <section class="border-t border-white/8 bg-bg-secondary py-24 md:py-32">
      <Container>
        <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
          <div>
            <p class="mb-2 font-mono text-xs tracking-wider text-accent-primary">READY TO COLLABORATE?</p>
            <h2 class="font-sans text-2xl font-bold tracking-tight text-foreground md:text-3xl">
              Let's build what's next.
            </h2>
          </div>
          <a
            href="/contact"
            class="group inline-flex items-center gap-3 border border-accent-primary/30 px-6 py-3 font-mono text-xs font-bold tracking-wider text-accent-primary transition-all hover:border-accent-primary hover:bg-accent-primary/10"
          >
            INITIATE A CONVERSATION
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>
