---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/shared/Container.astro';
import ProjectsGrid from '@/components/sections/projects-grid.astro';
import { CaseStudyViewer } from '@/components/islands/case-study-viewer';

const allCaseStudies: CollectionEntry<'caseStudies'>[] = await getCollection('caseStudies');

const serializedCaseStudies = allCaseStudies.map((study) => ({
  id: study.id,
  data: {
    title: study.data.title,
    client: study.data.client,
    description: study.data.description,
    coverImage: study.data.coverImage,
    videoUrl: study.data.videoUrl,
    posterUrl: study.data.posterUrl,
    techStack: study.data.techStack,
    idea: study.data.idea,
    experience: study.data.experience,
    technology: study.data.technology,
    process: study.data.process,
    venue: study.data.venue,
    scope: study.data.scope,
  },
}));
---

<BaseLayout title="Projects — LabXR.art" description="Selected projects and case studies from LabXR.art">
  <main id="main-content" class="pt-20">
    <!-- Page Hero -->
    <section class="border-t border-white/8 bg-bg-primary py-24 md:py-32">
      <Container>
        <div class="max-w-4xl">
          <p class="mb-4 font-mono text-xs tracking-wider text-accent-primary">01 / PROJECTS</p>
          <h1 class="mb-6 font-sans text-4xl font-bold tracking-tight text-foreground md:text-5xl lg:text-6xl">
            What we create.
          </h1>
          <p class="max-w-2xl font-sans text-lg leading-relaxed text-text-secondary">
            Each project is an exploration — a convergence of technology, design, narrative, and
            space. From immersive XR environments to interactive installations, we engineer
            experiences that push the boundaries of what's possible.
          </p>
        </div>
      </Container>
    </section>

    <!-- Projects Grid with Filtering -->
    <ProjectsGrid caseStudies={allCaseStudies} />
  </main>

  <CaseStudyViewer client:idle caseStudies={serializedCaseStudies} />
</BaseLayout>
