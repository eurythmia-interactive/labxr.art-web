---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/hero.astro';
import WebGLShowcase from '@/components/sections/webgl-showcase.astro';
import Manifesto from '@/components/sections/manifesto.astro';
import Services from '@/components/sections/services.astro';
import Portfolio from '@/components/sections/portfolio.astro';
import Team from '@/components/sections/team.astro';
import Contact from '@/components/sections/contact.astro';
import WhatsAppButton from '@/components/shared/whatsapp-button.astro';
import { CaseStudyViewer } from '@/components/islands/case-study-viewer';

const allCaseStudies: CollectionEntry<'caseStudies'>[] = await getCollection('caseStudies');
const allServices: CollectionEntry<'services'>[] = await getCollection('services');

const featuredCaseStudies = allCaseStudies.slice(0, 6);
const featuredServices = allServices.slice(0, 3);

const serializedCaseStudies = allCaseStudies.map((study) => ({
  id: study.id,
  data: {
    title: study.data.title,
    client: study.data.client,
    description: study.data.description,
    coverImage: study.data.coverImage,
    videoUrl: study.data.videoUrl,
    posterUrl: study.data.posterUrl,
    techStack: study.data.techStack,
  },
}));
---

<BaseLayout
  title="LabXR.art — Code & Cinema"
  description="Creative technology lab in CDMX bridging Code and Cinema. White-label interactive installations and WebGL experiences."
>
  <main id="main-content">
    <Hero />
    <WebGLShowcase />
    <Manifesto />
    <Services data={featuredServices} />
    <Portfolio data={featuredCaseStudies} />
    <Team />
    <Contact />
  </main>

  <WhatsAppButton />
  <CaseStudyViewer client:idle caseStudies={serializedCaseStudies} />
</BaseLayout>
