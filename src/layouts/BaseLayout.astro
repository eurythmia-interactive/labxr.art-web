---
import '@/styles/global.css';
import '@/styles/themes/cinematic-dark.css';
import '@/styles/themes/minimal-mono.css';
import '@/styles/themes/neo-brutalist.css';
import '@/styles/themes/glassmorphism.css';
import '@/styles/themes/gradient-frosted-glass.css';
import '@/styles/themes/gradient-sunset-glass.css';
import '@/styles/themes/gradient-aurora-glass.css';
import '@/styles/themes/gradient-neon-glass.css';
import '@/styles/themes/lab-terminal.css';
import '@/styles/themes/nature-rainforest.css';
import '@/styles/themes/nature-desert.css';
import '@/styles/themes/nature-mountain.css';
import '@/styles/themes/nature-caribbean.css';
import SkipNav from '@/components/shared/SkipNav.astro';
import NavigationHud from '@/components/shared/navigation-hud.astro';
import Footer from '@/components/shared/footer.astro';
import { LabCursor } from '@/components/islands/lab-cursor';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'LabXR.art - Creative technology lab in CDMX',
  ogImage = '/og-default.jpg',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="theme-frosted">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- FOUC Prevention: Apply saved theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('labxr-theme');
          if (saved) {
            document.documentElement.className = saved;
          }
        } catch (e) {}
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Plausible Analytics -->
    <script is:inline defer data-domain="labxr.art" src="https://plausible.io/js/script.js"></script>
  </head>
  <body class="bg-background text-foreground antialiased">
    <SkipNav />
    <NavigationHud />
    <slot />
    <Footer />
    <LabCursor client:load />
  </body>
</html>
